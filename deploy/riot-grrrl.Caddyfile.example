# Candidate only: choose a domain and qualify a public allowlist before ingress activation.
http://REPLACE_WITH_APPROVED_DOMAIN {
  reverse_proxy riot-grrrl-public-web:80
  header {
    >Cache-Control "no-store"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    -Server
  }
}
