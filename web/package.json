{
  "name": "@subculture/arkhiv-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "lint": "eslint .",
    "test": "vitest run src",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@subcult/archive-viewer": "0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
